{
  "name": "a11y-widget-kit",
  "version": "0.1.0",
  "description": "Framework-agnostic, i18n-ready accessibility preferences widget: high contrast, text scaling, readable font, link highlighting and reduced motion. Includes a React adapter.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "widget",
    "toolbar",
    "dyslexia",
    "high-contrast",
    "font-size",
    "reduced-motion",
    "i18n",
    "rtl",
    "react"
  ],
  "license": "MIT",
  "author": "Abin G",
  "homepage": "https://github.com/abin-g/a11y-widget-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abin-g/a11y-widget-kit.git"
  },
  "bugs": {
    "url": "https://github.com/abin-g/a11y-widget-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/a11y-widget-kit.global.js",
  "jsdelivr": "./dist/a11y-widget-kit.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./locales/*": {
      "import": {
        "types": "./dist/locales/*.d.ts",
        "default": "./dist/locales/*.js"
      },
      "require": {
        "types": "./dist/locales/*.d.cts",
        "default": "./dist/locales/*.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./global": "./dist/a11y-widget-kit.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/a11y-widget-kit.global.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:exports": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css global",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:exports",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "publint": "^0.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
